[Unit]
Description=TouchGal API
After=network.target

[Service]
WorkingDirectory=/opt/touchgal-developer/backend
EnvironmentFile=/opt/touchgal-developer/backend/.env
ExecStart=/usr/local/bin/touchgal-api
Restart=always
RestartSec=5
MemoryMax=512M
CPUQuota=100%
TasksMax=256
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
