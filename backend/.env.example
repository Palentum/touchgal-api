APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# 本项目独立数据库
DATABASE_DSN=postgres://touchgal_api:touchgal_api@localhost:5432/touchgal_api?sslmode=disable

# 主项目数据库，只读账号
SOURCE_DATABASE_DSN=postgres://readonly_user:password@main-db-host:5432/touchgal?sslmode=require

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cookie/session
SESSION_SECRET=please-change-this-64-byte-secret
SESSION_COOKIE_NAME=tgal_dev_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720

# 邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=TouchGal API

# 验证码
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# API token
API_TOKEN_PEPPER=please-change-this-long-random-secret
API_TOKEN_PREFIX=tgal_live
DEFAULT_TOKEN_MINUTE_LIMIT=60
DEFAULT_TOKEN_DAILY_LIMIT=5000

# 同步
ENABLE_SYNC_WORKER=true
SYNC_INTERVAL_MINUTES=30
SYNC_FULL_INTERVAL_HOURS=24
SYNC_INCREMENTAL_SAFETY_MINUTES=10
SYNC_DEFAULT_CONTENT_POLICY=all

# 站点链接
TOUCHGAL_SITE_URL=https://www.touchgal.ink
TOUCHGAL_TECH_DOCS_URL=https://github.com/KUN1007/kun-touchgal-next
API_DOCS_URL=/docs/api
