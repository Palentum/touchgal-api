APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_HEADER_BYTES=1048576
ENABLE_PPROF=false
ENABLE_METRICS=false
OBSERVABILITY_ADDR=127.0.0.1:6060
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# 本项目 clean DB，指向主机上的 PostgreSQL；Docker Compose 中运行后端时把 localhost 改为 host.docker.internal
DATABASE_DSN=postgres://touchgal_api:touchgal_api@localhost:5432/touchgal_api?sslmode=disable

# 主项目数据库，只读账号；生产默认只配置给独立 sync worker，API 进程保持 ENABLE_SYNC_WORKER=false 时不需要
SOURCE_DATABASE_DSN=postgres://readonly_user:password@main-db-host:5432/touchgal?sslmode=require

# API clean DB pool 与超时；PostgreSQL timeout 值为 0 表示禁用
DB_POOL_MAX_CONNS=16
DB_POOL_MIN_CONNS=1
DB_POOL_MIN_IDLE_CONNS=0
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=15m
DB_POOL_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=1m
DB_QUERY_TIMEOUT=35s

# sync 写入 clean DB 使用独立连接池；默认由独立 worker 分批提交，避免占用 API pool
SYNC_DB_POOL_MAX_CONNS=4
SYNC_DB_POOL_MIN_CONNS=0
SYNC_DB_POOL_MIN_IDLE_CONNS=0
SYNC_DB_POOL_MAX_CONN_LIFETIME=1h
SYNC_DB_POOL_MAX_CONN_IDLE_TIME=15m
SYNC_DB_POOL_HEALTH_CHECK_PERIOD=1m
SYNC_DB_STATEMENT_TIMEOUT=15m
SYNC_DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=5m
SYNC_DB_QUERY_TIMEOUT=16m

# source 主库只读连接池
SOURCE_DB_POOL_MAX_CONNS=4
SOURCE_DB_POOL_MIN_CONNS=0
SOURCE_DB_POOL_MIN_IDLE_CONNS=0
SOURCE_DB_POOL_MAX_CONN_LIFETIME=1h
SOURCE_DB_POOL_MAX_CONN_IDLE_TIME=15m
SOURCE_DB_POOL_HEALTH_CHECK_PERIOD=1m
SOURCE_DB_STATEMENT_TIMEOUT=15m
SOURCE_DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=1m
SOURCE_DB_QUERY_TIMEOUT=16m

# 主机上的 Redis；Docker Compose 中运行后端时可改为 host.docker.internal:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_POOL_SIZE=0
REDIS_MIN_IDLE_CONNS=0
REDIS_DIAL_TIMEOUT=0
REDIS_READ_TIMEOUT=0
REDIS_WRITE_TIMEOUT=0
REDIS_POOL_TIMEOUT=0

# Cookie/session
SESSION_SECRET=please-change-this-64-byte-secret
SESSION_COOKIE_NAME=tgal_dev_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720
SESSION_AUTH_CACHE_TTL_SECONDS=60
SESSION_LAST_SEEN_UPDATE_INTERVAL_SECONDS=300

# 邮件
MAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=TouchGal API
MAIL_SEND_TIMEOUT_SECONDS=10
POSTAL_API_URL=https://postal.example.com
POSTAL_API_KEY=

# 验证码
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# API token
API_TOKEN_PEPPER=please-change-this-long-random-secret
API_TOKEN_PREFIX=tgal_live
DEFAULT_TOKEN_MINUTE_LIMIT=60
DEFAULT_TOKEN_DAILY_LIMIT=5000

# /v1 防护与写入节流
API_PREAUTH_IP_MINUTE_LIMIT=600
API_PREAUTH_IP_DAILY_LIMIT=20000
API_TOKEN_AUTH_CACHE_TTL_SECONDS=60
MAX_ACTIVE_TOKENS_PER_USER=10
API_LAST_USED_UPDATE_INTERVAL_SECONDS=300

# /v1 request log 异步批量写入与 raw log 保留
API_REQUEST_LOG_QUEUE_SIZE=16384
API_REQUEST_LOG_BATCH_SIZE=500
API_REQUEST_LOG_FLUSH_INTERVAL=1s
API_REQUEST_LOG_RETENTION_DAYS=14

# 同步
ENABLE_SYNC_WORKER=false
SYNC_INTERVAL_MINUTES=30
SYNC_FULL_INTERVAL_HOURS=24
SYNC_INCREMENTAL_SAFETY_MINUTES=10
SYNC_DEFAULT_CONTENT_POLICY=all

# 站点链接
TOUCHGAL_SITE_URL=https://www.touchgal.ink
TOUCHGAL_TECH_DOCS_URL=https://github.com/KUN1007/kun-touchgal-next
API_DOCS_URL=/docs/api
